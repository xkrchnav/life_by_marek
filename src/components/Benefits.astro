---
import { benefits } from "../data/home";
import { icons } from "../data/icons";
---

<section class="section section-green" id="vyhody">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Co řeším</p>
      <h2>Nejen kila. Hlavně to, co vydrží.</h2>
      <p class="lead">
        Zdraví se nepozná podle váhy. Poznáš ho podle toho, jak zvládáš den – a co ti vydrží za
        dvacet let.
      </p>
    </div>
    <div class="cards">
      {
        benefits.map((benefit, index) => (
          <article class="card reveal" style={`transition-delay: ${index * 80}ms`}>
            <span class="card-icon" set:html={icons[benefit.icon]}></span>
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
