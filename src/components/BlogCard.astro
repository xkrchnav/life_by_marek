---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatDate } from "../lib/format";

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  tag?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  headingLevel?: "h2" | "h3";
}

const { href, title, description, date, tag, image, imageAlt, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<article class="post-card">
  <a class="post-card-link" href={href}>
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt ?? ""}
          widths={[400, 640, 880]}
          sizes="(min-width: 980px) 22rem, 92vw"
          class="post-card-img"
        />
      ) : (
        <span class="post-card-fallback" aria-hidden="true">
          <span>life_by_marek</span>
        </span>
      )
    }
    <span class="post-card-body">
      <span class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {tag && <span class="post-tag">{tag}</span>}
      </span>
      <Heading>{title}</Heading>
      <span class="post-card-text">{description}</span>
      <span class="post-card-more">Číst článek <span aria-hidden="true">→</span></span>
    </span>
  </a>
</article>
