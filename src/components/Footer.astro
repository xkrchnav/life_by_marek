---
import { icons } from "../data/icons";
import { withBase } from "../lib/url";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <Logo light />
      <p>Zdraví, prevence a síla – lidsky a na roky.</p>
    </div>

    <div class="footer-actions">
      <nav class="footer-nav" aria-label="Patička">
        <a href={withBase("/clanky/")}>Články</a>
        <a href={withBase("/#caste-otazky")}>Časté otázky</a>
        <a href={withBase("/#prihlaska")}>Přihláška</a>
      </nav>
      <a
        class="btn btn-light"
        href="https://www.instagram.com/life_by_marek/"
        target="_blank"
        rel="noopener"
      >
        <Fragment set:html={icons.instagram} /> @life_by_marek
      </a>
      <p class="copyright">© {year} Marek Širůček</p>
    </div>
  </div>
</footer>
