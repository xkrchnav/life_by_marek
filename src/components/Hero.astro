---
import { Image } from "astro:assets";
import promena from "../assets/promena.jpg";
import { icons } from "../data/icons";
---

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Lifestyle a prevence</p>
      <h1>
        Zdraví, které<br />
        <span class="grad-text">ti vydrží.</span>
      </h1>
      <p class="lead">
        Neřeším jen kila. Učím lidi jíst, hýbat se a regenerovat tak, aby jim to vydrželo další
        desítky let. Tomu říkám zdravá dlouhověkost. Bez zákazů a bez hladovění.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#prihlaska">
          JDU DO TOHO <Fragment set:html={icons.arrow} />
        </a>
        <a class="btn btn-ghost" href="#jak-to-funguje">Jak to funguje</a>
      </div>
      <ul class="check-list">
        <li><Fragment set:html={icons.check} /> Bez diet a zákazů</li>
        <li><Fragment set:html={icons.check} /> Měřitelné výsledky</li>
        <li><Fragment set:html={icons.check} /> Plán na roky, ne na týdny</li>
      </ul>
    </div>

    <figure class="hero-media">
      <div class="hero-media-frame">
        <Image
          src={promena}
          alt="Marek Širůček dříve a dnes – srovnání před proměnou a po ní"
          widths={[360, 540, 720, 960, 1200]}
          sizes="(min-width: 960px) 34rem, 92vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>Dříve a dnes. A hlavně funkční i za dvacet let.</figcaption>
    </figure>
  </div>
</section>
