---
import { steps } from "../data/home";
---

<section class="section" id="jak-to-funguje">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Jak to funguje</p>
      <h2>Změřit. Nastavit. Udržet.</h2>
      <p class="lead">Žádná věda. Tři kroky, které dávají smysl i za rok.</p>
    </div>
    <div class="steps">
      {
        steps.map((step, index) => (
          <article class="step reveal" style={`transition-delay: ${index * 100}ms`}>
            <span class="step-number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
