---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { breadcrumbNode } from "../../lib/schema";
import { withBase } from "../../lib/url";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const title = "Články o zdraví, prevenci a Tanitě | life_by_marek";
const description =
  "Praktické články o zdravé dlouhověkosti, prevenci, složení těla a jídle bez zákazů. Píšu to, co mi funguje – krátce, jasně a bez slibů. Bez zázraků.";
---

<Layout
  title={title}
  description={description}
  schema={[breadcrumbNode(Astro.site ?? new URL("https://xkrchnav.github.io"), [
    { name: "Domů", path: "/" },
    { name: "Články", path: "/clanky/" },
  ])]}
>
  <main id="obsah" class="section">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Drobečková navigace">
        <a href={withBase("/")}>Domů</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Články</span>
      </nav>

      <header class="blog-head">
        <p class="eyebrow">Články</p>
        <h1>Zdraví bez omáčky.</h1>
        <p class="lead">
          Píšu o dlouhověkosti, prevenci, Tanitě a jídle, které vydrží. Krátce a k věci.
        </p>
      </header>

      {
        posts.length > 0 ? (
          <div class="blog-grid blog-grid--page">
            {posts.map((post, index) => (
              <div class="reveal" style={`transition-delay: ${index * 70}ms`}>
                <BlogCard
                  href={withBase(`/clanky/${post.id}/`)}
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.publishedAt}
                  tag={post.data.tags[0]}
                  image={post.data.image}
                  imageAlt={post.data.imageAlt}
                />
              </div>
            ))}
          </div>
        ) : (
          <p class="lead">První článek je na cestě.</p>
        )
      }

      <div class="blog-cta reveal">
        <h2>Chceš to probrat osobně?</h2>
        <p>Nech mi na sebe kontakt a ozvu se ti. Nezávazně a lidsky.</p>
        <a class="btn btn-primary" href={withBase("/#prihlaska")}>JDU DO TOHO</a>
      </div>
    </div>
  </main>
</Layout>
