---
import { Image } from "astro:assets";
import promena from "../assets/promena.jpg";
import marekAkce from "../assets/marek-akce.jpg";

const year = new Date().getFullYear();

const icons: Record<string, string> = {
  bolt: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  users: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  activity: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  moon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`,
  check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`,
  arrow: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`,
  instagram: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
};

const benefits = [
  {
    icon: "bolt",
    title: "Víc energie",
    text: "Ráno vstaneš s chutí a den zvládneš bez odpoledního propadu.",
  },
  {
    icon: "users",
    title: "Líp s dětmi",
    text: "Na hraní a blbnutí ti zbydou síly, ne jen touha odpočívat.",
  },
  {
    icon: "activity",
    title: "Lepší kondice",
    text: "Fotbal, kolo nebo túra. Radost z pohybu se ti vrátí.",
  },
  {
    icon: "moon",
    title: "Lepší spánek",
    text: "Tělo se lépe zregeneruje a ráno je znovu plné sil.",
  },
];

const steps = [
  {
    number: "01",
    title: "Jíš, co máš rád",
    text: "Žádné zákazy ani hladovění. Naučíme se jíst tak, aby to vydrželo napořád.",
  },
  {
    number: "02",
    title: "Pohyb je doplněk",
    text: "Nemusíš dřít hodiny v posilovně. Stačí pohyb, který tě baví a sedne ti do života.",
  },
  {
    number: "03",
    title: "Plán na míru",
    text: "Projdeme spolu, co chceš změnit, a nastavíme kroky přesně pro tebe.",
  },
];

const tickerItems = [
  "life_by_marek",
  "zdraví",
  "energie",
  "pohoda",
  "lepší spánek",
  "radost z pohybu",
  "jídlo, které miluješ",
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>life_by_marek — Líp se cítit, líp vypadat, líp žít</title>
    <meta
      name="description"
      content="Zdravé hubnutí a životní styl s Markem Širůčkem. Jednoduché kroky místo drastických diet. Nech mi na sebe kontakt a jdeme na to spolu."
    />
    <meta name="theme-color" content="#7AC143" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content="life_by_marek — Líp se cítit, líp vypadat, líp žít" />
    <meta
      property="og:description"
      content="Jednoduché kroky ke zdraví, lepší postavě a větší energii. Bez drastických diet. JDU DO TOHO!"
    />
    <meta property="og:image" content="/og.jpg" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="#top" aria-label="life_by_marek — úvod">
          <span class="logo-mark" aria-hidden="true">
            <svg viewBox="0 0 64 64">
              <defs>
                <linearGradient id="logo-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#7AC143"></stop>
                  <stop offset="1" stop-color="#2E7CC4"></stop>
                </linearGradient>
              </defs>
              <rect width="64" height="64" rx="15" fill="url(#logo-grad)"></rect>
              <path
                d="M15 45V21l17 17 17-17v24"
                fill="none"
                stroke="#fff"
                stroke-width="6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
          <span class="logo-text"><strong>life</strong>_by_marek</span>
        </a>

        <nav class="nav" aria-label="Hlavní navigace">
          <a href="#vyhody">Co získáš</a>
          <a href="#jak-to-funguje">Jak to funguje</a>
          <a href="#pribeh">Příběh</a>
        </nav>

        <div class="header-actions">
          <a
            class="icon-link"
            href="https://www.instagram.com/life_by_marek/"
            target="_blank"
            rel="noopener"
            aria-label="Instagram life_by_marek"
          >
            <Fragment set:html={icons.instagram} />
          </a>
          <a class="btn btn-sm" href="#prihlaska">JDU DO TOHO</a>
        </div>
      </div>
    </header>

    <main id="obsah">
      <section class="hero" id="top">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Projekt life_by_marek</p>
            <h1>
              Líp se cítit.<br />
              Líp vypadat.<br />
              <span class="grad-text">Líp žít.</span>
            </h1>
            <p class="lead">
              Jím, co mám rád. Drastické diety neřeším. A přesto mám méně kil a víc energie než dřív.
              Ukážu ti jednoduché kroky – a nastavíme je na míru tobě.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#prihlaska">
                JDU DO TOHO <Fragment set:html={icons.arrow} />
              </a>
              <a class="btn btn-ghost" href="#jak-to-funguje">Jak to funguje</a>
            </div>
            <ul class="check-list">
              <li><Fragment set:html={icons.check} /> Bez zákazů a hladovění</li>
              <li><Fragment set:html={icons.check} /> Pohyb, který tě baví</li>
              <li><Fragment set:html={icons.check} /> Lidsky a individuálně</li>
            </ul>
          </div>

          <figure class="hero-media">
            <div class="hero-media-frame">
              <Image
                src={promena}
                alt="Marek Širůček dříve a dnes – srovnání před proměnou a po ní"
                widths={[360, 540, 720, 960, 1200]}
                sizes="(min-width: 960px) 34rem, 92vw"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <figcaption>Dříve a dnes – a hlavně lepší pocit.</figcaption>
          </figure>
        </div>
      </section>

      <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
          <div class="ticker-group">
            {
              tickerItems.map((item) => (
                <span class="ticker-item">
                  {item} <span class="ticker-dot">•</span>
                </span>
              ))
            }
          </div>
          <div class="ticker-group">
            {
              tickerItems.map((item) => (
                <span class="ticker-item">
                  {item} <span class="ticker-dot">•</span>
                </span>
              ))
            }
          </div>
        </div>
      </div>

      <section class="section section-green" id="vyhody">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="eyebrow">Co získáš</p>
            <h2>Nejde jen o kila. Jde o život.</h2>
            <p class="lead">
              Změna se pozná hlavně v tom, jak se cítíš. Tohle se mi změnilo a můžeš to mít taky.
            </p>
          </div>
          <div class="cards">
            {
              benefits.map((benefit, index) => (
                <article class="card reveal" style={`transition-delay: ${index * 80}ms`}>
                  <span class="card-icon" set:html={icons[benefit.icon]}></span>
                  <h3>{benefit.title}</h3>
                  <p>{benefit.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="jak-to-funguje">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="eyebrow">Jak to funguje</p>
            <h2>Tři jednoduché kroky</h2>
            <p class="lead">Žádná věda. Jen cesta, která vydrží i v běžném týdnu.</p>
          </div>
          <div class="steps">
            {
              steps.map((step, index) => (
                <article class="step reveal" style={`transition-delay: ${index * 100}ms`}>
                  <span class="step-number">{step.number}</span>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section-blue" id="pribeh">
        <div class="wrap about-grid">
          <figure class="about-media reveal">
            <Image
              src={marekAkce}
              alt="Marek Širůček na akci se stánkem zdraví a kondice"
              widths={[320, 480, 640, 880]}
              sizes="(min-width: 920px) 30rem, 92vw"
            />
            <figcaption>Osobně, lidsky a s úsměvem.</figcaption>
          </figure>

          <div class="about-copy reveal">
            <p class="eyebrow">Příběh</p>
            <h2>Těsně před třicítkou vypadám líp než ve třiadvaceti</h2>
            <p>
              Nejde ale jen o kila. Líp se cítím, líp stíhám děti, líp se mi hraje fotbal, líp spím a
              regeneruju. Změna přišla postupně – díky jednoduchým krokům, které zvládne každý.
            </p>
            <p>
              Jím pořád to, co mám rád. A i s méně pohybem než dřív to funguje. Pohyb je totiž
              doplněk, ne hlavní cíl.
            </p>
            <blockquote>„Když to jde mně, půjde to i tobě.“</blockquote>
            <p class="signature">Marek Širůček · life_by_marek</p>
            <a
              class="btn btn-ghost btn-insta"
              href="https://www.instagram.com/life_by_marek/"
              target="_blank"
              rel="noopener"
            >
              <Fragment set:html={icons.instagram} /> Sleduj na Instagramu
            </a>
          </div>
        </div>
      </section>

      <section class="section cta" id="prihlaska">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="eyebrow">Přihláška</p>
            <h2>Jdeme na to spolu?</h2>
            <p class="lead">
              Nech mi na sebe kontakt a ozvu se ti. V klidu probereme, co chceš změnit, a ukážeme si,
              co spolu dokážeme.
            </p>
          </div>

          <div class="form-card reveal">
            <form id="lead-form" novalidate>
              <div class="field">
                <label for="name">Jméno</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  placeholder="Tvoje jméno"
                  required
                />
                <p class="field-error-message">Vyplň prosím svoje jméno.</p>
              </div>
              <div class="field">
                <label for="email">E-mail</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  placeholder="tvuj@email.cz"
                  required
                />
                <p class="field-error-message">Zadej prosím platný e-mail.</p>
              </div>
              <div class="field">
                <label for="phone">Telefon</label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  inputmode="tel"
                  placeholder="+420 123 456 789"
                  required
                />
                <p class="field-error-message">Zadej prosím platné telefonní číslo.</p>
              </div>
              <button class="btn btn-primary btn-block" type="submit">
                JDU DO TOHO <Fragment set:html={icons.arrow} />
              </button>
              <p class="form-note">Žádný spam. Ozvu se ti osobně a nezávazně.</p>
            </form>

            <div class="form-success" id="form-success" hidden tabindex="-1">
              <span class="success-icon"><Fragment set:html={icons.check} /></span>
              <h3>Díky, mám to!</h3>
              <p>Ozvu se ti co nejdřív a domluvíme se na dalších krocích.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <a class="logo logo-light" href="#top">
            <span class="logo-mark" aria-hidden="true">
              <svg viewBox="0 0 64 64">
                <rect width="64" height="64" rx="15" fill="#7AC143"></rect>
                <path
                  d="M15 45V21l17 17 17-17v24"
                  fill="none"
                  stroke="#fff"
                  stroke-width="6"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
            <span class="logo-text"><strong>life</strong>_by_marek</span>
          </a>
          <p>Zdraví, energie a pohoda – lidsky a na míru.</p>
        </div>

        <div class="footer-actions">
          <a
            class="btn btn-light"
            href="https://www.instagram.com/life_by_marek/"
            target="_blank"
            rel="noopener"
          >
            <Fragment set:html={icons.instagram} /> @life_by_marek
          </a>
          <p class="copyright">© {year} Marek Širůček</p>
        </div>
      </div>
    </footer>

    <script>
      const form = document.querySelector<HTMLFormElement>("#lead-form");
      const success = document.querySelector<HTMLElement>("#form-success");

      const isValid: Record<string, (value: string) => boolean> = {
        name: (value) => value.trim().length >= 2,
        email: (value) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value.trim()),
        phone: (value) => value.replace(/\D/g, "").length >= 9,
      };

      const validateField = (input: HTMLInputElement) => {
        const check = isValid[input.name];
        const valid = check ? check(input.value) : true;
        input.closest(".field")?.classList.toggle("field-error", !valid);
        input.setAttribute("aria-invalid", String(!valid));
        return valid;
      };

      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        const inputs = Array.from(form.querySelectorAll("input"));
        let firstInvalid: HTMLInputElement | null = null;

        for (const input of inputs) {
          if (!validateField(input) && !firstInvalid) {
            firstInvalid = input;
          }
        }

        if (firstInvalid) {
          firstInvalid.focus();
          return;
        }

        form.hidden = true;
        if (success) {
          success.hidden = false;
          success.focus();
        }
      });

      form?.querySelectorAll("input").forEach((input) => {
        input.addEventListener("blur", () => validateField(input));
        input.addEventListener("input", () => {
          if (input.closest(".field")?.classList.contains("field-error")) {
            validateField(input);
          }
        });
      });

      const revealElements = document.querySelectorAll<HTMLElement>(".reveal");

      if (revealElements.length > 0 && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );

        revealElements.forEach((element) => observer.observe(element));
      } else {
        revealElements.forEach((element) => element.classList.add("is-visible"));
      }
    </script>

    <style is:global>
      :root {
        --green: #7ac143;
        --green-dark: #4e9427;
        --green-darker: #3f7c1f;
        --green-soft: #eff9e8;
        --blue: #2e7cc4;
        --blue-dark: #1f5e9c;
        --blue-soft: #eaf4fc;
        --ink: #12324a;
        --muted: #51718a;
        --line: #dce9f2;
        --radius: 20px;
        --shadow: 0 10px 30px rgba(18, 50, 74, 0.08);
        --shadow-lg: 0 24px 60px rgba(18, 50, 74, 0.16);
        --grad: linear-gradient(135deg, #7ac143 0%, #2e7cc4 100%);
        --grad-text: linear-gradient(120deg, #3f7c1f, #1f5e9c);
        --grad-cta: linear-gradient(135deg, #4e9427, #2e7cc4);
        --grad-cta-dark: linear-gradient(135deg, #3f7c1f, #1f5e9c);
        --font: "Manrope", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-padding-top: 5.5rem;
        -webkit-text-size-adjust: 100%;
      }

      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }
      }

      body {
        margin: 0;
        font-family: var(--font);
        font-size: 1rem;
        line-height: 1.65;
        color: var(--ink);
        background: #fff;
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      h1,
      h2,
      h3 {
        margin: 0 0 0.75rem;
        line-height: 1.15;
        letter-spacing: -0.02em;
      }

      p {
        margin: 0 0 1rem;
      }

      a {
        color: var(--blue-dark);
      }

      .wrap {
        width: 100%;
        max-width: 70rem;
        margin-inline: auto;
        padding-inline: 1.25rem;
      }

      .skip-link {
        position: absolute;
        left: 1rem;
        top: -4rem;
        z-index: 100;
        padding: 0.65rem 1.1rem;
        border-radius: 999px;
        background: var(--ink);
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        transition: top 0.2s ease;
      }

      .skip-link:focus {
        top: 0.75rem;
      }

      h1 {
        font-size: clamp(2.1rem, 8.5vw, 3.6rem);
        font-weight: 800;
      }

      h2 {
        font-size: clamp(1.65rem, 5.5vw, 2.5rem);
        font-weight: 800;
      }

      h3 {
        font-size: 1.15rem;
        font-weight: 800;
      }

      .lead {
        font-size: clamp(1rem, 2.6vw, 1.15rem);
        color: var(--muted);
      }

      .eyebrow {
        display: inline-block;
        margin: 0 0 1rem;
        padding: 0.35rem 0.95rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: #fff;
        color: var(--green-darker);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .grad-text {
        background: var(--grad-text);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0.85rem 1.6rem;
        border: 2px solid transparent;
        border-radius: 999px;
        font-family: inherit;
        font-size: 1.05rem;
        font-weight: 800;
        line-height: 1.2;
        text-decoration: none;
        cursor: pointer;
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease,
          background-color 0.18s ease,
          border-color 0.18s ease;
      }

      .btn svg {
        width: 1.15em;
        height: 1.15em;
        flex-shrink: 0;
      }

      .btn-primary {
        background: var(--grad-cta);
        color: #fff;
        font-size: 1.2rem;
        box-shadow: 0 12px 28px rgba(46, 124, 196, 0.28);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 34px rgba(46, 124, 196, 0.36);
      }

      .btn-sm {
        padding: 0.6rem 1.15rem;
        background: var(--grad-cta-dark);
        color: #fff;
        font-size: 0.95rem;
        box-shadow: 0 8px 18px rgba(31, 94, 156, 0.24);
      }

      .btn-ghost {
        background: #fff;
        border-color: var(--line);
        color: var(--blue-dark);
      }

      .btn-ghost:hover {
        border-color: var(--blue);
        transform: translateY(-2px);
      }

      .btn-light {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.35);
        color: #fff;
        font-size: 0.95rem;
      }

      .btn-light:hover {
        background: rgba(255, 255, 255, 0.22);
      }

      .btn-block {
        width: 100%;
      }

      :focus-visible {
        outline: 3px solid var(--blue);
        outline-offset: 2px;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 4.25rem;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--ink);
        font-size: 1.15rem;
        text-decoration: none;
        letter-spacing: -0.01em;
      }

      .logo strong {
        font-weight: 800;
      }

      .logo-text {
        font-weight: 500;
      }

      .logo-mark {
        display: inline-flex;
        width: 2.1rem;
        height: 2.1rem;
      }

      .logo-mark svg {
        width: 100%;
        height: 100%;
      }

      .nav {
        display: none;
      }

      .nav a {
        color: var(--ink);
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
      }

      .nav a:hover {
        color: var(--green-darker);
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .icon-link {
        display: none;
        align-items: center;
        justify-content: center;
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 50%;
        border: 1px solid var(--line);
        color: var(--blue-dark);
        transition:
          border-color 0.18s ease,
          color 0.18s ease;
      }

      .icon-link:hover {
        border-color: var(--blue);
        color: var(--blue);
      }

      .icon-link svg {
        width: 1.2rem;
        height: 1.2rem;
      }

      @media (min-width: 720px) {
        .nav {
          display: flex;
          gap: 1.75rem;
