      .hero {
        position: relative;
        padding-block: clamp(2.5rem, 8vw, 5rem) clamp(3rem, 9vw, 6rem);
        isolation: isolate;
        overflow: hidden;
      }

      .hero::before,
      .hero::after {
        content: "";
        position: absolute;
        z-index: -1;
        border-radius: 50%;
        filter: blur(70px);
        opacity: 0.55;
      }

      .hero::before {
        width: 26rem;
        height: 26rem;
        top: -9rem;
        right: -9rem;
        background: #c4e8ab;
      }

      .hero::after {
        width: 24rem;
        height: 24rem;
        bottom: -10rem;
        left: -9rem;
        background: #bcdff7;
      }

      .hero-grid {
        display: grid;
        gap: 2.75rem;
      }

      .hero-copy {
        max-width: 34rem;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin: 1.75rem 0 1.5rem;
      }

      .check-list {
        display: grid;
        gap: 0.55rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .check-list li {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 700;
        font-size: 0.95rem;
      }

      .check-list svg {
        width: 1.15rem;
        height: 1.15rem;
        padding: 0.22rem;
        border-radius: 50%;
        background: var(--green-soft);
        color: var(--green-darker);
        flex-shrink: 0;
      }

      .hero-media {
        position: relative;
        margin: 0;
      }

      .hero-media-frame {
        position: relative;
        isolation: isolate;
      }

      .hero-media-frame::before {
        content: "";
        position: absolute;
        inset: 1.5rem -0.9rem -0.9rem 1.5rem;
        z-index: -1;
        border-radius: 28px;
        background: var(--grad);
        opacity: 0.9;
      }

      .hero-media-frame img {
        width: 100%;
        border: 6px solid #fff;
        border-radius: 24px;
        box-shadow: var(--shadow-lg);
      }

      .hero-media figcaption,
      .about-media figcaption {
        margin-top: 0.9rem;
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--muted);
        text-align: center;
      }

      @media (min-width: 960px) {
        .hero-grid {
          grid-template-columns: 1.02fr 0.98fr;
          align-items: center;
          gap: 3.5rem;
        }

        .hero-media-frame img {
          border-width: 8px;
        }
      }

      .ticker {
        overflow: hidden;
        padding-block: 0.85rem;
        background: var(--grad);
        color: #fff;
      }

      .ticker-track {
        display: flex;
        width: max-content;
      }

      .ticker-group {
        display: flex;
        gap: 2.25rem;
        padding-right: 2.25rem;
      }

      .ticker-item {
        display: inline-flex;
        align-items: center;
        gap: 2.25rem;
        font-size: 0.85rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .ticker-dot {
        opacity: 0.7;
      }

      @media (prefers-reduced-motion: no-preference) {
        .ticker-track {
          animation: ticker 30s linear infinite;
        }

        @keyframes ticker {
          to {
            transform: translateX(-50%);
          }
        }
      }

      .section {
        padding-block: clamp(3.5rem, 9vw, 6.5rem);
      }

      .section-green {
        background: linear-gradient(180deg, #f4fbee, #ffffff);
      }

      .section-blue {
        background: linear-gradient(180deg, #f0f7fd, #ffffff);
      }

      .section-head {
        max-width: 44rem;
        margin: 0 auto 2.75rem;
        text-align: center;
      }

      .section-head .lead {
        margin-bottom: 0;
      }

      .cards {
        display: grid;
        gap: 1.25rem;
      }

      .card {
        padding: 1.7rem 1.5rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: #fff;
        box-shadow: var(--shadow);
        transition:
          transform 0.2s ease,
          border-color 0.2s ease;
      }

      .card:hover {
        transform: translateY(-4px);
        border-color: #bfe3a6;
      }

      .card h3 {
        margin-bottom: 0.4rem;
      }

      .card p {
        margin-bottom: 0;
        font-size: 0.95rem;
        color: var(--muted);
      }

      .card-icon {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        margin-bottom: 1.1rem;
        border-radius: 14px;
        background: var(--green-soft);
        color: var(--green-darker);
      }

      .card:nth-child(even) .card-icon {
        background: var(--blue-soft);
        color: var(--blue-dark);
      }

      .card-icon svg {
        width: 1.5rem;
        height: 1.5rem;
      }

      @media (min-width: 600px) {
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 1000px) {
        .cards {
          grid-template-columns: repeat(4, 1fr);
        }
      }

      .steps {
        display: grid;
        gap: 1.5rem;
      }

      .step {
        padding: 1.9rem 1.6rem 1.7rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: #fff;
        box-shadow: var(--shadow);
      }

      .step-number {
        display: inline-block;
        margin-bottom: 0.75rem;
        font-size: 2.4rem;
        font-weight: 800;
        line-height: 1;
        background: var(--grad-text);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .step p {
        margin-bottom: 0;
        font-size: 0.98rem;
        color: var(--muted);
      }

      @media (min-width: 820px) {
        .steps {
          grid-template-columns: repeat(3, 1fr);
          gap: 1.75rem;
        }
      }

      .about-grid {
        display: grid;
        gap: 2.75rem;
      }

      .about-media {
        margin: 0;
        position: relative;
      }

      .about-media img {
        width: 100%;
        border: 6px solid #fff;
        border-radius: 24px;
        box-shadow: var(--shadow-lg);
      }

      .about-copy h2 {
        margin-bottom: 1.25rem;
      }

      .about-copy p {
        color: var(--muted);
      }

      .about-copy blockquote {
        margin: 1.5rem 0;
        padding: 0.25rem 0 0.25rem 1.1rem;
        border-left: 4px solid var(--green);
        color: var(--ink);
        font-size: 1.15rem;
        font-weight: 800;
        line-height: 1.4;
      }

      .about-copy .signature {
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 1.25rem;
      }

      .btn-insta {
        font-size: 0.95rem;
        padding: 0.7rem 1.3rem;
      }

      @media (min-width: 920px) {
        .about-grid {
          grid-template-columns: 0.92fr 1.08fr;
          align-items: center;
          gap: 3.5rem;
        }
      }

      .cta {
        position: relative;
        background: var(--grad-cta);
        color: #fff;
        overflow: hidden;
      }

      .cta::before,
      .cta::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
      }

      .cta::before {
        width: 22rem;
        height: 22rem;
        top: -11rem;
        right: -7rem;
      }

      .cta::after {
        width: 16rem;
        height: 16rem;
        bottom: -9rem;
        left: -6rem;
      }

      .cta .wrap {
        position: relative;
        z-index: 1;
      }

      .cta .section-head {
        margin-bottom: 2.25rem;
      }

      .cta .eyebrow {
        background: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.4);
        color: #fff;
      }

      .cta h2 {
        color: #fff;
      }

      .cta .lead {
        color: rgba(255, 255, 255, 0.92);
      }

      .form-card {
        max-width: 34rem;
        margin-inline: auto;
        padding: clamp(1.6rem, 5vw, 2.5rem);
        border-radius: 24px;
        background: #fff;
        color: var(--ink);
        box-shadow: var(--shadow-lg);
      }

      .field {
        margin-bottom: 1.1rem;
      }

      .field label {
        display: block;
        margin-bottom: 0.4rem;
        font-size: 0.95rem;
        font-weight: 800;
      }

      .field input {
        width: 100%;
        padding: 0.85rem 1rem;
        border: 1.5px solid #c9dce8;
        border-radius: 14px;
        background: #fbfdff;
        color: var(--ink);
        font: inherit;
        transition:
          border-color 0.15s ease,
          box-shadow 0.15s ease;
      }

      .field input::placeholder {
        color: #8aa4b8;
      }

      .field input:focus {
        outline: none;
        border-color: var(--blue);
        box-shadow: 0 0 0 4px rgba(46, 124, 196, 0.16);
      }

      .field-error input {
        border-color: #d64545;
        background: #fff7f7;
      }

      .field-error-message {
        display: none;
        margin: 0.4rem 0 0;
        color: #b32d2d;
        font-size: 0.85rem;
        font-weight: 700;
      }

      .field-error .field-error-message {
        display: block;
      }

      .form-note {
        margin: 0.9rem 0 0;
        text-align: center;
        font-size: 0.85rem;
        color: var(--muted);
      }

      .form-success {
        padding: 1.5rem 0;
        text-align: center;
      }

      .form-success:focus {
        outline: none;
      }

      .form-success h3 {
        font-size: 1.5rem;
      }

      .form-success p {
        margin-bottom: 0;
        color: var(--muted);
      }

      .success-icon {
        display: grid;
        place-items: center;
        width: 3.5rem;
        height: 3.5rem;
        margin: 0 auto 1rem;
        border-radius: 50%;
        background: var(--grad-cta);
        color: #fff;
      }

      .success-icon svg {
        width: 1.7rem;
        height: 1.7rem;
      }

      .site-footer {
        padding-block: 2.75rem;
        background: var(--ink);
        color: rgba(255, 255, 255, 0.78);
      }

      .footer-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        text-align: center;
      }

      .footer-brand {
        display: grid;
        justify-items: center;
        gap: 0.6rem;
      }

      .footer-brand p {
        margin: 0;
        font-size: 0.95rem;
      }

      .logo-light {
        color: #fff;
      }

      .footer-actions {
        display: grid;
        justify-items: center;
        gap: 1rem;
      }

      .copyright {
        margin: 0;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.6);
      }

      @media (min-width: 760px) {
        .footer-inner {
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
          text-align: left;
        }

        .footer-brand {
          justify-items: start;
        }

        .footer-actions {
          justify-items: end;
        }
      }

      @media (prefers-reduced-motion: no-preference) {
        .js .reveal {
          opacity: 0;
          transform: translateY(20px);
          transition:
            opacity 0.6s ease,
            transform 0.6s ease;
        }

        .js .reveal.is-visible {
          opacity: 1;
          transform: none;
        }
      }
    </style>
